{
  "apiVersion": "cloudopsworks.io/v1",
  "kind": "BuildPlan",
  "repository": {
    "id": "12345",
    "fullName": "example/mixed-app"
  },
  "baseSha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
  "headSha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "version": "1.2.3",
  "event": "release",
  "prNumber": null,
  "components": [
    {
      "id": "api",
