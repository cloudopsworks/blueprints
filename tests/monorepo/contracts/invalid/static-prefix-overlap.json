        "source": "static",
        "port": 8080,
        "healthPath": "/"
      },
      "dependsOn": [],
      "targetIds": [
        "prod-run"
      ],
      "workload": {
        "kind": "static"
      }
    },
    {
      "id": "worker",
      "path": "components/worker",
      "language": "go",
      "framework": "plain",
      "buildProfile": "go",
      "toolchains": [
        {
          "tool": "go",
          "version": "1.26.7",
          "distribution": "default",
          "components": [
            "worker"
          ]
        }
