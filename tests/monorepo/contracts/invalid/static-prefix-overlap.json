      "framework": "plain",
      "buildProfile": "go",
      "toolchains": [
        {
          "tool": "go",
          "version": "1.26.7",
          "distribution": "default",
          "components": [
            "api"
          ]
        }
      ],
      "package": {
        "kind": "static",
        "directory": "dist",
        "index": "index.html"
