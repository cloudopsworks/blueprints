      "network": "fake noncredential access token; all HTTP(S) forced to dead-loopback proxy",
      "normalVersionReplacement": [
        "delete",
        "create"
      ],
      "graph": "new same-mode version waits old version destroy; traffic waits new version",
      "notProved": [
        "cloud API apply/delete success",
        "global service ownership and absence of foreign versions",
        "standard-flex cross-mode transition ordering",
        "partial-failure hosted recovery",
        "readiness",
        "historical oldfalse/native ownership rejection belongs trusted runtime semantic guard",
        "protected single-writer activation prerequisite and pre-apply inventory recheck"
      ],
      "actualRootPolicy": {
        "delete_service_on_destroy": true,
        "noop_on_destroy": false,
        "create_before_destroy": false
      },
      "planCases": [
        "fresh create",
        "synthetic already-exclusive-owned state update",
        "same-mode changed-artifact replacement",
        "whole-service destroy"
      ],
      "destroyScope": [
        "exclusive nondefault service via version Delete true (ALL enclosed versions)",
        "owned immutable package objects",
        "traffic state removal only"
      ]
    }
  },
  "candidateBoundary": {
    "productionRoot": "Approved exclusive-service root: true service-delete, false no-op, same-mode delete-before-create. Activation remains blocked until runtime semantic ownership/inventory/recovery proof.",
    "flagOnlyUpdate": "Both selected version Update implementations unconditionally POST version deployment, not state-only; no migration of historical false-flag states.",
    "crossEnvironment": "standard/flexible count-resource switch is not a same-address replacement and lacks safe service-wide ordering; trusted runtime must reject before apply.",
    "failureRecovery": "Deletion then creation failure leaves outage. Preserve verified state handle and canonical service claim; unknown pending operation or live survivor absent from native state blocks for separately reviewed reconciliation/adoption. Never automatic import/delete or blind retry. Exact Create ID-clear lines recorded per source.",
    "ownershipAssumption": "Prior state in offline plans is generated by mock Apply of actual root. This does not establish fresh-service history, global uniqueness, inventory or operator single-writer prerequisites."
  },
